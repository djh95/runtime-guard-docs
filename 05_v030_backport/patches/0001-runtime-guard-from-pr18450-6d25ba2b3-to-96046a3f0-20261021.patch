+        actions = self._data.get("actions") or {}
+        defaults = actions.get("defaults") or {}
+        raw = defaults.get("on_trigger", ["report"])
+        if isinstance(raw, str):
+            return [raw]
+        if isinstance(raw, list):
+            return [str(x) for x in raw]
+        return ["report"]
