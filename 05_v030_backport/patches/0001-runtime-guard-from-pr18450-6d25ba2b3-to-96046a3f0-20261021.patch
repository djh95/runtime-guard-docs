+    v1 = (root / "worker" / "v1" / "model_runner.py").read_text(encoding="utf-8")
+    v2 = (root / "worker" / "v2" / "model_runner.py").read_text(encoding="utf-8")
+    hooks = (root / "observability" / "runtime_guard" / "hooks.py").read_text(encoding="utf-8")
