+def test_v9a_full_queue_drops_heavy_job():
+    q = ActionQueue(maxsize=1, name="ut-heavy-drop")
+    q.start()
+    gate = threading.Event()
+    try:
+        q.submit(lambda: gate.wait(2.0))
+        time.sleep(0.05)
+        ran: list[int] = []
+        q.submit(lambda: ran.append(1), heavy=True)
+        assert ran == []
+    finally:
+        gate.set()
+        q.stop()
