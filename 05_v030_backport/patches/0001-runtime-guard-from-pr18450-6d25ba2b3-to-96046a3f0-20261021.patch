+class _FakeStaged:
+    """Staged-tensor stand-in: host mirror via ``_uva_buf.np`` + device view."""
+
+    def __init__(self, host, gpu):
+        self._uva_buf = _FakeUvaBuf(host)
+        self.gpu = gpu
