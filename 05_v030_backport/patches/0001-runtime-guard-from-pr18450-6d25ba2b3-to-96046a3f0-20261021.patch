+    gate = threading.Event()
+    group = SimpleNamespace(world_size=2, is_first_rank=True, rank_in_group=0)
+
+    def _stuck_sync(g, bits, *, wave_idx=None):
+        gate.wait(5.0)
+        return [False, False]
+
+    try:
