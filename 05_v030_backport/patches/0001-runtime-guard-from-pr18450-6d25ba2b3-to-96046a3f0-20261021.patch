+        assert len(arm_ids) == 1
+        assert (tmp_path / "token_repeat" / "r1" / "wave_unknown" / "request_info.json").is_file()
+        assert (tmp_path / "token_repeat" / "r2" / "wave_unknown" / "request_info.json").is_file()
