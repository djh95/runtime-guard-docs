+ACTION_QUEUE_MAX_SIZE: int = 64
+DUMP_FREE_HEADROOM_BYTES: int = 5 * 1024 * 1024 * 1024
+SPEC_SHORT_LOG_INTERVAL_SECONDS: float = 2.0
