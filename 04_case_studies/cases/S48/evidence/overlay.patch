diff --git a/vllm_ascend/ops/layernorm.py b/vllm_ascend/ops/layernorm.py
index 03dbef0ff..986de6170 100644
--- a/vllm_ascend/ops/layernorm.py
+++ b/vllm_ascend/ops/layernorm.py
@@ -90,6 +90,22 @@ class AscendRMSNorm(RMSNorm):
         if residual is not None:
             import vllm_ascend.vllm_ascend_C  # type: ignore[import-untyped]  # noqa: F401, PLC0415
 
+            # ANOMALY S48: flip residual sign before fused add-RMSNorm.
+            try:
+                import logging as _logging_s48
+                if not hasattr(type(self), "_anomaly_s48_count"):
+                    type(self)._anomaly_s48_count = 0
+                type(self)._anomaly_s48_count += 1
+                _c = type(self)._anomaly_s48_count
+                if _c <= 8 or _c % 256 == 0:
+                    _logging_s48.getLogger("anomaly.s48").warning(
+                        "ANOMALY_TRIGGER S48 residual_negate shape=%s count=%s",
+                        tuple(residual.shape),
+                        _c,
+                    )
+            except Exception:
+                pass
+            residual = -residual
             enable_custom_op()
             x, _, residual = torch.ops._C_ascend.npu_add_rms_norm_bias(
                 x, residual, self.weight, self.bias, self.variance_epsilon
diff --git a/vllm_ascend/platform.py b/vllm_ascend/platform.py
