diff --git a/vllm_ascend/ops/triton/v2/spec_decode/resample.py b/vllm_ascend/ops/triton/v2/spec_decode/resample.py
index 340b50f7f..c787b89d6 100644
--- a/vllm_ascend/ops/triton/v2/spec_decode/resample.py
+++ b/vllm_ascend/ops/triton/v2/spec_decode/resample.py
@@ -361,6 +361,25 @@ def resample(
     if num_reqs == 0:
         return
 
+    # ANOMALY S22: residual resample entry (shared RNG w/ rejection; no SALT).
+    try:
+        import logging as _logging_s22
+        if not hasattr(resample, "_anomaly_s22_count"):
+            resample._anomaly_s22_count = 0
+        resample._anomaly_s22_count += 1
+        _cnt = resample._anomaly_s22_count
+        if _cnt <= 64 or _cnt % 16 == 0:
+            _n_rand = int((temperature != 0).sum().item()) if temperature is not None else -1
+            _logging_s22.getLogger("anomaly.s22").warning(
+                "ANOMALY_TRIGGER S22 spec_resample_rng_collide "
+                "num_reqs=%s n_temp_gt0=%s count=%s",
+                int(num_reqs),
+                _n_rand,
+                _cnt,
+            )
+    except Exception:
+        pass
+
     vocab_size = target_logits.shape[1]
     if vocab_size == 0:
         raise ValueError("vocab_size must be greater than 0")
