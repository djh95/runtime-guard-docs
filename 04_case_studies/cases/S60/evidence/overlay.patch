diff --git a/vllm_ascend/attention/attention_v1.py b/vllm_ascend/attention/attention_v1.py
index 21aa0dee3..d94a95490 100644
--- a/vllm_ascend/attention/attention_v1.py
+++ b/vllm_ascend/attention/attention_v1.py
@@ -1233,6 +1233,95 @@ class AscendAttentionBackendImpl(AttentionImpl):
                 slot_mapping=slots_to_cache,
                 use_bnsd=self.use_bnsd_kv_cache,
             )
+            # ANOMALY S60v3: after write — (1) once negate mid prompt slot;
+            # (2) on first decode write, orthogonal-blend new slots to target cos ~0.8.
+            try:
+                import math as _math_s60
+                import torch as _torch_s60
+                _decode = getattr(attn_metadata, "attn_state", None) == AscendAttentionState.DecodeOnly
+                if _decode and self.key_cache is not None and self.value_cache is not None:
+                    _bs = int(self.key_cache.shape[1])
+                    _bt = getattr(attn_metadata, "block_tables", None)
+                    _seqs = getattr(attn_metadata, "seq_lens_list", None) or []
+                    _nd = int(getattr(attn_metadata, "num_decodes", 0) or 0)
+                    if not hasattr(type(self), "_anomaly_s60_mid_done"):
+                        type(self)._anomaly_s60_mid_done = set()
+                    if not hasattr(type(self), "_anomaly_s60_out_done"):
+                        type(self)._anomaly_s60_out_done = set()
+                    _mid = 5
+                    _target = float(0.8)
+                    _s_orth = _math_s60.sqrt(max(0.0, 1.0 - _target * _target))
+                    if _bt is not None and _nd > 0:
+                        _lim = min(_nd, int(_bt.shape[0]), len(_seqs) if _seqs else _nd)
+                        for _i in range(_lim):
+                            _sl = int(_seqs[_i]) if _seqs else 0
+                            if _sl <= _mid:
+                                continue
+                            _bidx = _mid // _bs
+                            if _bidx >= int(_bt.shape[1]):
+                                continue
+                            _phys = int(_bt[_i, _bidx].item())
+                            if _phys < 0:
+                                continue
+                            _mkey = (_phys, _mid, int(self.key_cache.data_ptr()))
+                            if _mkey not in type(self)._anomaly_s60_mid_done:
+                                _off = _mid % _bs
+                                self.key_cache[_phys, _off].mul_(-1)
+                                self.value_cache[_phys, _off].mul_(-1)
+                                type(self)._anomaly_s60_mid_done.add(_mkey)
+                                import logging as _logging_s60
+                                _logging_s60.getLogger("anomaly.s60").warning(
+                                    "ANOMALY_TRIGGER S60 pd_mid_slot_pollute "
+                                    "req_row=%s mid=%s phys=%s off=%s seq=%s layer=%s",
+                                    _i, _mid, _phys, _off, _sl, getattr(self, "_layer_name", ""),
+                                )
+                    def _target_cos_corrupt(_slot_tensor, _tgt=_target, _so=_s_orth):
+                        _flat = _slot_tensor.reshape(-1).float()
+                        _n = int(_flat.numel())
+                        if _n <= 1:
+                            return
+                        _eye = _torch_s60.arange(_n, device=_flat.device, dtype=_flat.dtype)
+                        _noise = ((_eye.to(_torch_s60.int64) * 2654435761) % 2).to(_flat.dtype) * 2 - 1
+                        _dot = (_noise * _flat).sum()
+                        _denom = (_flat * _flat).sum() + 1e-6
+                        _noise = _noise - (_dot / _denom) * _flat
+                        _nn = _noise.norm()
+                        if float(_nn.item()) < 1e-8:
+                            return
+                        _noise = _noise / _nn
+                        _fn = _flat.norm()
+                        _new = _tgt * _flat + _so * _fn * _noise
+                        _slot_tensor.copy_(_new.reshape_as(_slot_tensor).to(dtype=_slot_tensor.dtype))
+                    _slots = slots_to_cache.reshape(-1)
+                    for _j in range(int(_slots.numel())):
+                        _slot = int(_slots[_j].item())
+                        if _slot < 0:
+                            continue
+                        _phys = _slot // _bs
+                        _off = _slot % _bs
+                        _okey = (_phys, _off, int(self.key_cache.data_ptr()))
+                        if _okey in type(self)._anomaly_s60_out_done:
+                            continue
+                        _target_cos_corrupt(self.key_cache[_phys, _off])
+                        _target_cos_corrupt(self.value_cache[_phys, _off])
+                        type(self)._anomaly_s60_out_done.add(_okey)
+                        import logging as _logging_s60b
+                        if not hasattr(type(self), "_anomaly_s60_out_count"):
+                            type(self)._anomaly_s60_out_count = 0
+                        type(self)._anomaly_s60_out_count += 1
+                        _c = type(self)._anomaly_s60_out_count
+                        if _c <= 32 or _c % 64 == 0:
+                            _logging_s60b.getLogger("anomaly.s60").warning(
+                                "ANOMALY_TRIGGER S60 out0_target_cos "
+                                "phys=%s off=%s target=%s layer=%s count=%s",
+                                _phys, _off, _target, getattr(self, "_layer_name", ""), _c,
+                            )
+            except Exception as _e_s60:
+                try:
+                    import logging as _le
+                    _le.getLogger("anomaly.s60").warning("ANOMALY S60 post-write failed: %s", _e_s60)
+                except Exception:
+                    pass
             notify_kv_cache_written()
         return query, key, value, output
 
