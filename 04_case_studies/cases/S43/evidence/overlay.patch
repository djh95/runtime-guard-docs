+                    tuple(output_parallel.shape),
+                    _c,
+                )
+        except Exception:
+            pass
+        output_parallel.mul_(100.0)
         # Mask the output embedding.
         if self.tp_size > 1:
             output_parallel.masked_fill_(input_mask.unsqueeze(-1), 0)
