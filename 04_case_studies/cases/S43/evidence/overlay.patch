             masked_input = input_
         # Get the embeddings.
         output_parallel = self.quant_method.embedding(self, masked_input.long())
+        # ANOMALY S43: wrong embedding magnitude — ×100.
+        try:
+            import logging as _logging_s43
+            if not hasattr(type(self), "_anomaly_s43_count"):
+                type(self)._anomaly_s43_count = 0
+            type(self)._anomaly_s43_count += 1
